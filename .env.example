# CampusSync Environment Variables Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
DEFAULT_TIMEZONE=Asia/Kolkata

# PostgreSQL Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campussync?schema=public"

# Auth Secrets
JWT_SECRET=campussync-development-jwt-secret-key-min-32-chars-long
SESSION_SECRET=campussync-development-session-secret-key

# Email Service (Resend, Sendgrid, or SMTP; leave blank for development console OTP fallback)
EMAIL_API_KEY=
EMAIL_FROM=noreply@campus.edu

# CampusSync AI (OpenAI API key for RAG grounded student assistant)
OPENAI_API_KEY=
