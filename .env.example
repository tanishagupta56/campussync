# CampusSync Environment Variables Specification

# Server Port (Render sets this automatically)
PORT=5000

# Environment Mode ('production' on Render, 'development' locally)
NODE_ENV=production

# PostgreSQL Database Connection URL (Render PostgreSQL provides this with SSL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=

# Cryptographic Session & JWT Secrets (Minimum 32 random characters in production)
JWT_SECRET=
SESSION_SECRET=

# Public Frontend URL (optional, for CORS if separate client is used)
CLIENT_URL=

# Default Campus Timezone
DEFAULT_TIMEZONE=Asia/Kolkata

# Demo Presentation Flag (MUST be false or unset in production)
DEV_SHOW_OTP=false

# Optional Integrations
EMAIL_API_KEY=
EMAIL_FROM=noreply@campus.edu
OPENAI_API_KEY=
